{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tourgraph",
  // Our own entry (routing, redirects, API); it hands pages to the OpenNext build.
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Live on tourgraph.ai and www.tourgraph.ai since the Nov 1, 2026 switchover
  // (www redirects to the apex in src/server/route.ts). ROLLBACK: remove these
  // routes first, or the next deploy takes the hostnames back
  // (docs/cloudflare-architecture.md section 9).
  "routes": [
    { "pattern": "tourgraph.ai", "custom_domain": true },
    { "pattern": "www.tourgraph.ai", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tourgraph-db",
      "database_id": "8c7d8475-0130-4e69-8f5d-679d2f4305e4",
      "migrations_dir": "migrations"
    }
  ],
  // /roulette/hand: 30 requests per 10 s per IP, as the Express version had.
  "ratelimits": [
    { "name": "ROULETTE_LIMITER", "namespace_id": "3001", "simple": { "limit": 30, "period": 10 } }
  ]
}
